# 密钥与运行时状态（不入库）
config.toml
config.toml.bak.*
# config.toml.tmp 含明文 token，由 configedit 模块写出；与打包的泄漏兜底同源。
config.toml.tmp
state.json
state.json.tmp
state.json.corrupt.*
# Chromium profile 目录，落在 state_path 旁边（见 rust/src/fetch.rs 的 profile_dir）。
chromium-profile/
# .hawkeye-deploy.toml 是 hawkeye deploy 写出的连接参数文件（不含密码），
# 与打包的泄漏兜底同源（A6）。
.hawkeye-deploy.toml

# 部署包产物
dist/

# IDE
.idea/
*.iml
.vscode/

# macOS
.DS_Store

# Rust 构建产物
rust/target/
